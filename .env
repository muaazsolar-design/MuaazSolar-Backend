NODE_ENV=development
PORT=5000

# MongoDB Connection
# For MongoDB Atlas, use your connection string:
MONGODB_URI=mongodb+srv://muaaz:password123@cluster0.xxxxx.mongodb.net/muaazsolar

# OR for Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/muaazsolar

# JWT Secret (change this to a random long string)
JWT_SECRET=my_super_secret_jwt_key_change_this_to_something_random

# Email Configuration (Optional - for contact form)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ADMIN_EMAIL=admin@muaazsolar.com

# Frontend URL
FRONTEND_URL=http://localhost:3000